#!/usr/bin/env bash
# Itzel's Linux terminal launcher. Opens the graphical application.
set -euo pipefail
itzel_script_path=$(readlink -f -- "${BASH_SOURCE[0]}")
itzel_project_root=$(cd -- "$(dirname -- "$itzel_script_path")/.." && pwd)

itzel_usage() {
  cat <<'EOF'
Usage: itzel [open|start|status|stop]

  open     Start Itzel and open its browser interface (default)
  start    Start Itzel in the background and print its address
  status   Show the background-service status
  stop     Stop Itzel and its browser viewer

Itzel is a graphical app. Claude Code and Codex provide terminal chat separately.
EOF
}

itzel_url() {
  if [[ -n ${ITZEL_VIEWER_URL:-} ]]; then printf '%s\n' "$ITZEL_VIEWER_URL"; return; fi
  systemctl --user show itzel-viewer.service --property=Environment --value |
    python3 -c 'import shlex,sys; entries=shlex.split(sys.stdin.read()); print(next((v.split("=",1)[1] for v in entries if v.startswith("ITZEL_VIEWER_ORIGIN=")),""))'
}

case ${1:-open} in
  -h|--help|help) itzel_usage ;;
  open|start)
    if [[ $(systemctl --user show itzel-viewer.service --property=LoadState --value 2>/dev/null) != loaded ]]; then
      cd -- "$itzel_project_root"
      exec npm start
    fi
    systemctl --user start itzel-desktop.service itzel-viewer.service
    itzel_address=$(itzel_url)
    if [[ -z $itzel_address ]]; then
      echo 'Itzel started. See systemctl --user status itzel-viewer for its address.'
      exit 0
    fi
    printf 'Itzel: %s\n' "$itzel_address"
    if [[ ${1:-open} == open && ( -n ${DISPLAY:-} || -n ${WAYLAND_DISPLAY:-} ) ]] && command -v xdg-open >/dev/null; then
      nohup xdg-open "$itzel_address" >/dev/null 2>&1 < /dev/null &
    fi
    ;;
  status) exec systemctl --user status itzel-desktop.service itzel-viewer.service --no-pager --lines=4 ;;
  stop) exec systemctl --user stop itzel-viewer.service itzel-desktop.service ;;
  *) itzel_usage >&2; exit 2 ;;
esac
